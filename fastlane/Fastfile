default_platform(:ios)

platform :ios do
  before_all do
    ENV["LC_ALL"] = "en_US.UTF-8"
    ENV["LANG"] = "en_US.UTF-8"
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"] || "DVJNXL6S6Z",
      issuer_id: ENV["ASC_ISSUER_ID"] || "ae4d38ba-6282-4907-b8e8-26af5b3b11a7",
      key_filepath: ENV["ASC_KEY_PATH"] || File.expand_path("~/.appstoreconnect/private_keys/AuthKey_DVJNXL6S6Z.p8"),
      in_house: false
    )
  end

  desc "Take screenshots via snapshot"
  lane :screenshots do
    snapshot
  end

  desc "Frame screenshots with device frames and titles"
  lane :frame do
    frameit(
      path: "./fastlane/screenshots",
      force_device_type: "iPhone 16 Pro Max"
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :publish do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: "com.kutican.bahcebirlestir",
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload metadata only (no screenshots)"
  lane :deliver_metadata do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: "com.kutican.bahcebirlestir",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )
  end
end

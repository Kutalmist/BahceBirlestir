default_platform(:ios)

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: "DVJNXL6S6Z",
      issuer_id: "ae4d38ba-6282-4907-b8e8-26af5b3b11a7",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_DVJNXL6S6Z.p8"),
      in_house: false
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :deliver_metadata do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: "com.kutican.bahcebirlestir",
      skip_binary_upload: true,
      skip_screenshots: false,
      force: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )
  end
end
